  "handmatig": [
    {
      "punt": "2",
      "tekst": "De PostgreSQL-database draait in Docker."
    },
    {
      "punt": "3",
      "tekst": "`appsettings.json` bevat een connectiestring met de naam `PostgresConnection`."
    },
    {
      "punt": "4",
      "tekst": "Map Data met `ArtikelContext : DbContext` en `DbSet<Artikel> Artikelen`; de kolommen staan in `OnModelCreating` met de Fluent API; de context is in Program.cs geregistreerd met `UseNpgsql` en de connectiestring `PostgresConnection`."
    },
    {
      "punt": "6",
      "tekst": "Het SQL-script met de startgegevens is zelf geschreven, en de startlijst van `InMemoryArtikelRepository` is gelijk aan de tabel."
    },
    {
      "punt": "7",
      "tekst": "De migratie `GarantieToegevoegd` voegt in `Up` de kolom toe en haalt ze in `Down` weer weg; de student verklaart welke waarde de bestaande artikelen na het bijwerken in `Garantiejaren` kregen."
    },
    {
      "punt": "7",
      "tekst": "De kolom `Garantiejaren` kwam er via een migratie, niet via een ALTER TABLE."
    }
