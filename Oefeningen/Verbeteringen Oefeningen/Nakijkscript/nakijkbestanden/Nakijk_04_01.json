          "id": "5.1",
          "punt": "5",
          "uitleg": "De tabel Artikelen bestaat met de kolommen uit punt 4, geen enkele mag leeg blijven",
          "sql": "SELECT column_name, data_type, character_maximum_length, is_nullable FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'Artikelen' AND column_name <> 'Garantiejaren'",
          "verwacht": {
            "rijen": [
              [
                "AantalOpVoorraad",
                "integer",
                "",
                "NO"
              ],
              [
                "Id",
                "integer",
                "",
                "NO"
              ],
              [
