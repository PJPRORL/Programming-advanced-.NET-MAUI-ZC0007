    {
      "id": "S2",
      "titel": "Testscenario punt 11",
      "start": "herstart",
      "stappen": [
        {
          "id": "11.1",
          "punt": "11",
          "uitleg": "Stap 1: fiche opvragen, met de velden uit punt 11",
          "verzoek": {
            "methode": "GET",
            "pad": "bestellijn/fiche"
          },
          "verwacht": {
            "status": 200,
            "json": {
              "aantalActieveLijnen": {
                "$elk": true
              },
              "aantalGeschrapteLijnen": {
                "$elk": true
              },
              "totaalActief": {
                "$elk": true
              },
              "totaalGeschrapt": {
                "$elk": true
              },
              "duursteActieveLijn": {
                "$elk": true
              },
              "isLeeg": {
                "$elk": true
              }
            }
          },
          "bewaar": {
            "actief1": "aantalActieveLijnen",
            "totaal1": "totaalActief"
          }
        },
        {
          "id": "11.2",
          "punt": "11",
          "uitleg": "Stap 2: een lijn toevoegen",
          "verzoek": {
            "methode": "POST",
            "pad": "bestellijn",
            "body": {
              "omschrijving": "Serverkast volledig uitgerust",
              "aantal": 2,
              "stukPrijs": 50000,
              "isActief": true
            }
          },
          "verwacht": {
            "status": 201
          },
          "bewaar": {
            "nieuw": "id"
          }
        },
        {
          "id": "11.3",
          "punt": "11",
          "uitleg": "Fiche na stap 2: één actieve lijn meer, totaal + 100000, de nieuwe lijn is de duurste",
          "verzoek": {
            "methode": "GET",
            "pad": "bestellijn/fiche"
          },
          "verwacht": {
            "status": 200,
            "json": {
              "$bevat": {
                "aantalActieveLijnen": {
                  "$reken": "{{actief1}} + 1"
                },
                "totaalActief": {
                  "$reken": "{{totaal1}} + 100000"
                },
                "duursteActieveLijn": {
                  "id": "{{nieuw}}",
                  "omschrijving": "Serverkast volledig uitgerust",
                  "aantal": 2,
                  "stukPrijs": 50000,
                  "isActief": true
                },
                "isLeeg": false
              }
            }
          },
          "bewaar": {
            "actief2": "aantalActieveLijnen",
            "totaal2": "totaalActief",
            "geschrapt2": "aantalGeschrapteLijnen",
            "totaalGeschrapt2": "totaalGeschrapt"
          }
        },
        {
          "id": "11.4",
          "punt": "11",
          "uitleg": "Stap 3: die lijn schrappen",
          "verzoek": {
            "methode": "DELETE",
            "pad": "bestellijn/{{nieuw}}"
          },
          "verwacht": {
            "status": 204
          }
        },
        {
          "id": "11.5",
          "punt": "11",
          "uitleg": "Fiche na stap 3: één actieve lijn minder, één geschrapte meer, 100000 van actief naar geschrapt",
          "verzoek": {
            "methode": "GET",
            "pad": "bestellijn/fiche"
          },
          "verwacht": {
            "status": 200,
            "json": {
              "$bevat": {
                "aantalActieveLijnen": {
                  "$reken": "{{actief2}} - 1"
                },
                "totaalActief": {
                  "$reken": "{{totaal2}} - 100000"
                },
                "aantalGeschrapteLijnen": {
                  "$reken": "{{geschrapt2}} + 1"
                },
                "totaalGeschrapt": {
                  "$reken": "{{totaalGeschrapt2}} + 100000"
                }
              }
            }
          }
        },
        {
          "id": "11.6",
          "punt": "11",
          "uitleg": "Stap 4: die lijn herstellen",
          "verzoek": {
            "methode": "PUT",
            "pad": "bestellijn/herstel/{{nieuw}}"
          },
          "verwacht": {
            "status": 204
          }
        },
        {
          "id": "11.7",
          "punt": "11",
          "uitleg": "Fiche na stap 4: alles weer zoals na stap 2",
          "verzoek": {
            "methode": "GET",
            "pad": "bestellijn/fiche"
          },
          "verwacht": {
            "status": 200,
            "json": {
              "$bevat": {
                "aantalActieveLijnen": "{{actief2}}",
                "totaalActief": "{{totaal2}}",
                "aantalGeschrapteLijnen": "{{geschrapt2}}",
                "totaalGeschrapt": "{{totaalGeschrapt2}}",
                "duursteActieveLijn": {
                  "id": "{{nieuw}}",
                  "omschrijving": "Serverkast volledig uitgerust",
                  "aantal": 2,
                  "stukPrijs": 50000,
                  "isActief": true
                },
                "isLeeg": false
              }
            }
          }
        },
        {
          "id": "11.8",
          "punt": "11",
          "uitleg": "Stap 5: de hele bestelling schrappen geeft de bijgewerkte fiche; alle actieve lijnen zijn nu geschrapt",
          "verzoek": {
            "methode": "DELETE",
            "pad": "bestellijn"
          },
          "verwacht": {
            "status": 200,
            "json": {
              "aantalActieveLijnen": 0,
              "aantalGeschrapteLijnen": {
                "$reken": "{{geschrapt2}} + {{actief2}}"
              },
              "totaalActief": 0,
              "totaalGeschrapt": {
                "$reken": "{{totaalGeschrapt2}} + {{totaal2}}"
              },
              "duursteActieveLijn": null,
              "isLeeg": true
            }
          }
        },
        {
          "id": "11.9",
          "punt": "11",
          "uitleg": "Fiche na stap 5",
          "verzoek": {
            "methode": "GET",
            "pad": "bestellijn/fiche"
          },
          "verwacht": {
            "status": 200,
            "json": {
              "aantalActieveLijnen": 0,
              "aantalGeschrapteLijnen": {
                "$reken": "{{geschrapt2}} + {{actief2}}"
              },
              "totaalActief": 0,
              "totaalGeschrapt": {
                "$reken": "{{totaalGeschrapt2}} + {{totaal2}}"
              },
              "duursteActieveLijn": null,
              "isLeeg": true
            }
          }
        },
        {
          "id": "11.10",
          "punt": "3",
          "uitleg": "Geen actieve lijnen meer",
          "verzoek": {
            "methode": "GET",
            "pad": "bestellijn"
          },
          "verwacht": {
            "status": 200,
