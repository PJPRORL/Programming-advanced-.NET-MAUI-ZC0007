  "handmatig": [
    {
      "punt": "2",
      "tekst": "`ITicketRepository` bevat enkel methodes die gegevens ophalen of bewaren; geldigheid, plaatscontrole en statuscodes beslist de controller."
    },
    {
      "punt": "3",
      "tekst": "`InMemoryTicketRepository` bevat de lijst; constructor injection van `ITicketRepository` en `ILogger<TicketController>`; Information per verzoek, Warning bij elke 400 en 404; annuleren blijft een soft delete."
    },
    {
      "punt": "4",
      "tekst": "`BestandTicketRepository` leest `tickets.json` bij de start, schrijft de startlijst weg als het bestand niet bestaat, en schrijft na elke wijziging; het bestand bevat leesbare JSON met `IsGeannuleerd`."
    },
    {
      "punt": "5",
      "tekst": "Wisselen in Program.cs zonder iets aan de TicketController te veranderen. Het script test met de bestandsrepository."
