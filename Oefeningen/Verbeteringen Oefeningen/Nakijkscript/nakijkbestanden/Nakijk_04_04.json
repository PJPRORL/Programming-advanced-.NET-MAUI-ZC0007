          "punt": "5",
          "uitleg": "De tabel Dieren bestaat met de kolommen uit punt 4, geen enkele mag leeg blijven",
          "sql": "SELECT column_name, data_type, character_maximum_length, is_nullable FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'Dieren' AND column_name <> 'IsGechipt'",
          "verwacht": {
            "rijen": [
              [
                "Id",
