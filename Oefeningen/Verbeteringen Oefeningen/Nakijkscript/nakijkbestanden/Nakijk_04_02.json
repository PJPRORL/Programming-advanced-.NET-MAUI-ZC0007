        {
          "id": "3.3",
          "punt": "3",
          "uitleg": "Id is de sleutel van Ventilatoren en de database telt zelf op",
          "sql": "SELECT kcu.column_name, (c.is_identity = 'YES' OR c.column_default LIKE 'nextval%') FROM information_schema.table_constraints tc JOIN information_schema.key_column_usage kcu ON kcu.constraint_name = tc.constraint_name AND kcu.table_schema = tc.table_schema AND kcu.table_name = tc.table_name JOIN information_schema.columns c ON c.table_schema = kcu.table_schema AND c.table_name = kcu.table_name AND c.column_name = kcu.column_name WHERE tc.table_schema = 'public' AND tc.table_name = 'Ventilatoren' AND tc.constraint_type = 'PRIMARY KEY'",
          "verwacht": {
            "rijen": [
              [
                "Id",
                "t"
              ]
            ],
            "volgorde": "vast"
          }
