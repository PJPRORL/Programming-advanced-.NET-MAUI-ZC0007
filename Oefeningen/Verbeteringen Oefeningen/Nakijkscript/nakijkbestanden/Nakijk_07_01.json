        {
          "id": "4.1",
          "punt": "4",
          "uitleg": "De migratie Controle is weer verwijderd: de database kent ze niet",
          "sql": "SELECT \"MigrationId\" FROM \"__EFMigrationsHistory\" WHERE \"MigrationId\" LIKE '%\\_Controle'",
          "verwacht": {
            "aantal": 0
          }
        },
        {
          "id": "6.1a",
          "punt": "6",
          "uitleg": "Leverancier 2 bijwerken",
          "verzoek": {
            "methode": "PUT",
            "pad": "leverancier/2",
            "body": {
              "naam": "Componentenhuis NL",
              "land": "Nederland"
            }
          },
          "verwacht": {
            "status": 204
          }
        },
        {
          "id": "6.1b",
          "punt": "6",
          "uitleg": "Leverancier 2 toont de nieuwe naam",
          "verzoek": {
            "methode": "GET",
            "pad": "leverancier/2"
          },
          "verwacht": {
            "status": 200,
            "json": {
              "$bevat": {
                "naam": "Componentenhuis NL"
              }
            }
          }
        },
        {
