          "id": "6.0",
          "punt": "6",
          "uitleg": "Voorbereiding: een actieve lijn van 2 x 12.50 toevoegen, die in stap 2 geschrapt wordt",
          "verzoek": {
            "methode": "POST",
            "pad": "bestellijn",
            "body": {
              "omschrijving": "Testlijn A",
              "aantal": 2,
              "stukPrijs": 12.5,
              "isActief": true
            }
          },
          "verwacht": {
            "status": 201,
            "json": {
              "id": {
                "$elk": true
