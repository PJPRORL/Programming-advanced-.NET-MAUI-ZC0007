                "$elk": true
              },
              "totaalGeschrapt": {
                "$elk": true
              },
              "duursteActieveLijn": {
                "$elk": true
              },
              "isLeeg": false
            }
          },
          "bewaar": {
            "a1": "aantalActieveLijnen",
            "g1": "aantalGeschrapteLijnen",
            "ta1": "totaalActief",
            "tg1": "totaalGeschrapt"
