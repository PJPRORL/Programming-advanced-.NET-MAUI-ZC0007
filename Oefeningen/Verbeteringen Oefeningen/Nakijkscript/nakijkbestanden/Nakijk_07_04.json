          "verwacht": {
            "aantal": 0
          }
        },
        {
          "id": "6.1a",
          "punt": "6",
          "uitleg": "Verblijf 2 bijwerken",
          "verzoek": {
            "methode": "PUT",
            "pad": "verblijf/2",
            "body": {
              "naam": "Hondenweide",
              "capaciteit": 4
            }
          },
          "verwacht": {
            "status": 204
          }
        },
        {
          "id": "6.1b",
          "punt": "6",
          "uitleg": "Verblijf 2 toont de nieuwe naam",
          "verzoek": {
            "methode": "GET",
            "pad": "verblijf/2"
          },
          "verwacht": {
            "status": 200,
            "json": {
