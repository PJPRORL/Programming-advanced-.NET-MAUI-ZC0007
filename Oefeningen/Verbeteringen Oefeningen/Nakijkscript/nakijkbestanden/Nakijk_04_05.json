            "methode": "GET",
            "pad": "fiets"
          },
          "verwacht": {
            "status": 200,
            "json": {
              "$verzameling": [
                {
                  "id": 1,
                  "type": "stadsfiets",
                  "framemaat": 54,
                  "prijsPerDag": 12.5,
                  "isBeschikbaar": true
                },
                {
                  "id": 2,
                  "type": "mountainbike",
                  "framemaat": 48,
                  "prijsPerDag": 18.0,
                  "isBeschikbaar": true
                },
                {
                  "id": 3,
                  "type": "e-bike",
                  "framemaat": 56,
                  "prijsPerDag": 25.0,
                  "isBeschikbaar": false
