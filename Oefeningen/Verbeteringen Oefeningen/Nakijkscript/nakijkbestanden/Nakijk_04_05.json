          "uitleg": "De tabel Fietsen heeft de kolommen uit punt 3, geen enkele mag leeg blijven",
          "sql": "SELECT column_name, data_type, character_maximum_length, is_nullable FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'Fietsen'",
          "verwacht": {
            "rijen": [
              [
                "Framemaat",
                "integer",
                "",
                "NO"
              ],
              [
                "Id",
                "integer",
                "",
                "NO"
              ],
              [
                "IsBeschikbaar",
                "boolean",
                "",
                "NO"
              ],
              [
                "PrijsPerDag",
                "numeric",
                "",
                "NO"
              ],
              [
                "Type",
                "character varying",
                "30",
                "NO"
              ]
